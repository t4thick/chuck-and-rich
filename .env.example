# --- Copy values into .env.local (dev) and Vercel → Project → Settings → Environment Variables (production) ---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (only needed for local CLI / migrations)
# SUPABASE_DB_PASSWORD=

# --- Email (pick ONE transport; the others can stay empty) ---
#
# Option A — Gmail SMTP (easiest, free, no DNS).
#   1. Turn on 2-Step Verification on the Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-char password below (spaces will be stripped automatically).
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B — any other SMTP provider (SendGrid SMTP, Mailgun SMTP, your own server).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# Option C — Postmark HTTP API. Production-grade; needs verified sender or domain.
POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
#
# Friendly From header (optional). Defaults to "Lovely Queen African Market <GMAIL_USER>".
# Required for Postmark.
EMAIL_FROM=
#
# Where the store's "new order" alert email goes (you).
MERCHANT_ORDER_EMAIL=
#
# Optional: free SMS via your phone carrier (email-to-SMS gateway).
# Format: <10-digit-number>@<carrier-domain>
# Verizon=vtext.com  AT&T=txt.att.net  T-Mobile=tmomail.net  Sprint=messaging.sprintpcs.com
# Example: 6142904260@vtext.com
MERCHANT_SMS_GATEWAY_EMAIL=

# Public site URL — no trailing slash. Set on Vercel to your production domain (e.g. https://your-app.vercel.app).
# Required for Supabase email links (password reset, magic link, signup) and Stripe redirects
# so redirects never point at localhost.
NEXT_PUBLIC_SITE_URL=

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Publishable key (pk_test_…) — required for embedded card form (Payment Element) in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook secret from Stripe Dashboard → Developers → Webhooks → your endpoint
# Webhook endpoint must subscribe to:
#   - checkout.session.completed (hosted Stripe Checkout)
#   - payment_intent.succeeded   (embedded Payment Element)
STRIPE_WEBHOOK_SECRET=

# Optional: show "Continue with Google" on login/signup. Set to 1 after enabling Google in Supabase → Authentication → Providers.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=1

# Admin auth — gate the /admin dashboard.
# Set ADMIN_PASSWORD to a strong secret used at /admin/login.
# Set ADMIN_SESSION_SECRET to a long random value (>= 32 chars). Used to HMAC-sign the admin session
# cookie. If unset we fall back to ADMIN_PASSWORD for signing — set it explicitly in production so
# rotating the password doesn't simultaneously invalidate every active admin session.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional emergency bypass only — when unset / not "1", every admin route requires the signed cookie from POST /api/admin/login (ADMIN_PASSWORD).
# ADMIN_ALLOW_SUPABASE_ROLE=1

# Reporting timezone for dashboard calendar buckets (IANA). Columbus OH default.
# STORE_REPORT_TIMEZONE=America/New_York

# Twilio SMS — alerts the store phone when an order is paid.
# All four must be set or the SMS step is silently skipped (everything else still works).
# Sign up: https://www.twilio.com/console — Account SID + Auth Token live on the dashboard.
# A trial number can only text *verified* destinations until the account is upgraded.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MERCHANT_ALERT_PHONE=

# Optional dev-only: comma-separated LAN IPs allowed to load assets from `next dev`.
# DEV_PHONE_HOSTS=192.168.1.105
